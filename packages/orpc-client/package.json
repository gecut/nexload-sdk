{
  "name": "@nexload-sdk/orpc-client",
  "version": "2.0.1",
  "description": "A minimal, high-performance factory for creating optimized oRPC clients, designed for persistent, low-latency, server-to-server communication in cloud-native architectures.",
  "keywords": [
    "orpc",
    "rpc",
    "client",
    "nexload",
    "nexload-sdk",
    "cloud-native",
    "microservices",
    "server-to-server",
    "undici",
    "performance",
    "typescript",
    "type-safe"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "@nexload-sdk/env": "^3.0.1",
    "@nexload-sdk/logger": "^4.0.1",
    "@orpc/client": "^1.12.3",
    "@orpc/contract": "^1.12.3"
  },
  "devDependencies": {
    "@nexload-sdk/bundler": "workspace:*",
    "@nexload-sdk/eslint-config": "workspace:*",
    "@nexload-sdk/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
