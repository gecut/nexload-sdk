{
  "name": "@nexload-sdk/payload-fields",
  "version": "3.1.0",
  "description": "Production-grade semantic field factories and Admin integrations for Payload CMS.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "react",
    "fields",
    "custom-fields",
    "typescript",
    "slug",
    "jalali",
    "money",
    "nexload",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./slug": {
      "types": "./dist/slug/index.d.ts",
      "import": "./dist/slug/index.js",
      "default": "./dist/slug/index.js"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.js",
      "default": "./dist/date/index.js"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.js",
      "default": "./dist/money/index.js"
    },
    "./admin/slug-field": {
      "types": "./dist/admin/slug-field.d.ts",
      "import": "./dist/admin/slug-field.js",
      "default": "./dist/admin/slug-field.js"
    },
    "./admin/jalali-date-field": {
      "types": "./dist/admin/jalali-date-field.d.ts",
      "import": "./dist/admin/jalali-date-field.js",
      "default": "./dist/admin/jalali-date-field.js"
    },
    "./admin/jalali-date-cell": {
      "types": "./dist/admin/jalali-date-cell.d.ts",
      "import": "./dist/admin/jalali-date-cell.js",
      "default": "./dist/admin/jalali-date-cell.js"
    },
    "./admin/money-field": {
      "types": "./dist/admin/money-field.d.ts",
      "import": "./dist/admin/money-field.js",
      "default": "./dist/admin/money-field.js"
    },
    "./admin/validated-text-field": {
      "types": "./dist/admin/validated-text-field.d.ts",
      "import": "./dist/admin/validated-text-field.js",
      "default": "./dist/admin/validated-text-field.js"
    },
    "./admin/formatted-cell": {
      "types": "./dist/admin/formatted-cell.d.ts",
      "import": "./dist/admin/formatted-cell.js",
      "default": "./dist/admin/formatted-cell.js"
    },
    "./admin/money-cell": {
      "types": "./dist/admin/money-cell.d.ts",
      "import": "./dist/admin/money-cell.js",
      "default": "./dist/admin/money-cell.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint src",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test:tz": "pnpm build && TZ=America/New_York node --test test/jalali.test.mjs"
  },
  "dependencies": {
    "react-day-picker": "^9.12.0",
    "@nexload-sdk/persian": "workspace:^"
  },
  "peerDependencies": {
    "@nexload-sdk/payload-schema": ">=2.0.0 <4.0.0",
    "@payloadcms/ui": ">=3.85.0 <4.0.0",
    "payload": ">=3.85.0 <4.0.0",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "zod": ">=4.1.0 <5.0.0"
  },
  "devDependencies": {
    "@nexload-sdk/bundler": "workspace:*",
    "@nexload-sdk/eslint-config": "workspace:*",
    "@nexload-sdk/typescript-config": "workspace:*",
    "@types/react": "^19.2.7",
    "@payloadcms/ui": "3.86.0",
    "payload": "3.86.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "@nexload-sdk/payload-schema": "workspace:*",
    "@payloadcms/db-sqlite": "3.86.0",
    "zod": "4.4.3"
  },
  "type": "module",
  "peerDependenciesMeta": {
    "@nexload-sdk/payload-schema": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
