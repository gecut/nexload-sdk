{
  "name": "@nexload-sdk/payload-fields",
  "version": "3.1.0",
  "description": "Production-grade semantic field factories and Admin integrations for Payload CMS.",
  "keywords": [
    "payload",
    "payloadcms",
    "payload-cms",
    "react",
    "fields",
    "custom-fields",
    "typescript",
    "slug",
    "jalali",
    "money",
    "nexload",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./slug": {
      "types": "./dist/slug/index.d.ts",
      "import": "./dist/slug/index.mjs",
      "require": "./dist/slug/index.cjs"
    },
    "./date": {
      "types": "./dist/date/index.d.ts",
      "import": "./dist/date/index.mjs",
      "require": "./dist/date/index.cjs"
    },
    "./money": {
      "types": "./dist/money/index.d.ts",
      "import": "./dist/money/index.mjs",
      "require": "./dist/money/index.cjs"
    },
    "./admin/slug-field": {
      "types": "./dist/admin/slug-field.d.ts",
      "import": "./dist/admin/slug-field.mjs",
      "require": "./dist/admin/slug-field.cjs"
    },
    "./admin/jalali-date-field": {
      "types": "./dist/admin/jalali-date-field.d.ts",
      "import": "./dist/admin/jalali-date-field.mjs",
      "require": "./dist/admin/jalali-date-field.cjs"
    },
    "./admin/jalali-date-cell": {
      "types": "./dist/admin/jalali-date-cell.d.ts",
      "import": "./dist/admin/jalali-date-cell.mjs",
      "require": "./dist/admin/jalali-date-cell.cjs"
    },
    "./admin/money-field": {
      "types": "./dist/admin/money-field.d.ts",
      "import": "./dist/admin/money-field.mjs",
      "require": "./dist/admin/money-field.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "react-day-picker": "^9.12.0"
  },
  "peerDependencies": {
    "@payloadcms/ui": ">=3.68.5 <4",
    "payload": ">=3.68.5 <4",
    "react": "^19.0.1 || ^19.1.2 || ^19.2.1",
    "react-dom": "^19.0.1 || ^19.1.2 || ^19.2.1"
  },
  "devDependencies": {
    "@nexload-sdk/bundler": "workspace:*",
    "@nexload-sdk/eslint-config": "workspace:*",
    "@nexload-sdk/typescript-config": "workspace:*",
    "@types/react": "^19.2.7",
    "@payloadcms/ui": "3.68.5",
    "payload": "3.68.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
