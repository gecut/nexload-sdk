{
  "name": "@nexload-sdk/payload-hooks",
  "version": "2.0.1",
  "private": false,
  "description": "Effortless, type-safe logging for Payload CMS collection operations.",
  "keywords": [
    "payload",
    "payload-cms",
    "hooks",
    "logging",
    "nexload",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@nexload-sdk/logger": "^4.0.1",
    "payload": "catalog:"
  },
  "devDependencies": {
    "@nexload-sdk/bundler": "workspace:*",
    "@nexload-sdk/eslint-config": "workspace:*",
    "@nexload-sdk/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
