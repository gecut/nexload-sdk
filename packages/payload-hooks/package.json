{
  "name": "@nexload-sdk/payload-hooks",
  "version": "3.0.0",
  "private": false,
  "description": "Effortless, type-safe logging for Payload CMS collection operations.",
  "keywords": [
    "payload",
    "payload-cms",
    "hooks",
    "logging",
    "nexload",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nexload-sdk/logger": "workspace:^"
  },
  "devDependencies": {
    "@nexload-sdk/bundler": "workspace:*",
    "@nexload-sdk/eslint-config": "workspace:*",
    "@nexload-sdk/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "payload": "catalog:"
  },
  "peerDependencies": {
    "payload": ">=3.85.0 <4.0.0"
  }
}
