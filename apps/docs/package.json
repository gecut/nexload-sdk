{
  "name": "docs",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "content:api": "node scripts/generate-api.mjs --check",
    "content:api:write": "node scripts/generate-api.mjs",
    "content:accessibility": "node scripts/validate-accessibility.mjs",
    "content:check": "node ../../scripts/validate-docs.mjs",
    "content:examples": "tsc --project examples/tsconfig.json --noEmit",
    "content:links": "node ../../scripts/validate-docs-links.mjs",
    "content:llms": "node scripts/generate-markdown.mjs --check",
    "content:llms:write": "node scripts/generate-markdown.mjs",
    "prebuild": "pnpm content:api:write && pnpm content:llms:write && pnpm content:check && pnpm content:examples",
    "build": "astro check && astro build && pnpm content:links",
    "test": "node --test tests/*.test.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.40.0",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@nexload-sdk/typescript-config": "workspace:*",
    "mdast-util-to-markdown": "^2.1.2",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "starlight-theme-flexoki": "^0.2.2",
    "typescript": "catalog:",
    "unified": "^11.0.5"
  }
}
